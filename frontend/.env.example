# MARSCOPE Frontend Environment Configuration (Vercel)
NEXT_PUBLIC_APP_NAME="MARSCOPE"
# Keep "/api" so Vercel rewrites proxy to Railway same-origin (preserves cookies + CSRF)
NEXT_PUBLIC_API_BASE_URL="/api"
NEXT_PUBLIC_STUDY_AREA="Gale Crater - Mount Sharp Boxwork Exploration Zone"

# REQUIRED on Vercel: Railway FastAPI backend HTTPS URL (no trailing slash)
BACKEND_INTERNAL_URL=https://your-railway-backend.up.railway.app
