# MARSCOPE Backend Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Study Region Metadata (never overrides explicit mission landing site)
STUDY_AREA_NAME="Gale Crater - Mount Sharp Boxwork Exploration Zone"
DEFAULT_CRS="IAU2000:49900"

# Multi-Astronaut Persistence & Security (Prompt 1)
# Development default uses durable SQLite at datasets/index/marscope_mission.sqlite when DATABASE_URL is unset.
# Production MUST configure a durable DATABASE_URL and strong MARSCOPE_SECRET_KEY.
DATABASE_URL=""
MARSCOPE_SECRET_KEY=""
AUTH_SESSION_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
POSITION_STALE_AFTER_SECONDS=120
AUDIO_UPLOAD_MAX_BYTES=10485760

# Optional Provider, Storage & Operator Service Tokens (never store secrets in repository)
TRACKING_INGEST_TOKEN=""
OPERATOR_ACTION_TOKEN=""
MARSCOPE_OPERATOR_TOKEN=""
MARSCOPE_DATASETS_DIR=""
