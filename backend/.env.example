# MARSCOPE Backend Environment Configuration (Railway / Docker)
ENVIRONMENT=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Persistent Volume Paths (mount Railway volume at /data)
MARSCOPE_DATASETS_DIR=/data/datasets
DATABASE_URL=sqlite:////data/datasets/index/marscope_mission.sqlite

# Required Security Secrets (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
MARSCOPE_SECRET_KEY=
MARSCOPE_OPERATOR_TOKEN=
TRACKING_INGEST_TOKEN=

# Cookie & CORS Policy (when Vercel proxies /api/* over HTTPS)
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
CORS_ORIGINS=["https://your-vercel-app.vercel.app"]
