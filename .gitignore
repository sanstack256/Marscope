# ==============================================================================
# MARSCOPE — Global .gitignore
# Martian Surface Intelligence & Exploration System
# ==============================================================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
credentials.json
token.json

# Python & Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
!frontend/src/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/
ENV/

# Node & Frontend
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.turbo

# Large Scientific Datasets & Raw Planetary Imagery
# Preserving catalogs while excluding bulk GIS rasters, processed derivatives, and local download manifests
datasets/raw/*
!datasets/raw/.gitkeep
datasets/processed/*
!datasets/processed/.gitkeep
datasets/manifests/*
!datasets/manifests/.gitkeep
datasets/index/*
!datasets/index/.gitkeep
datasets/private_attachments/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.tif
*.tiff
*.TIF
*.TIFF
*.jp2
*.JP2
*.img
*.IMG
*.lbl
*.LBL
*.cub
*.nc
*.nc4
*.h5
*.hdf5
*.dem
*.DEM
*.tar
*.tar.gz
*.zip
*.gz
*.bz2

# Local tiles and geocache
*.mbtiles
*.pmtiles
cache/
.cache/

# IDE & Editors
.idea/
.vscode/
*.swp
*.swo
*~
