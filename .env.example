# ==============================================================================
# MARSCOPE — Environment Configuration Template (Split Deployment)
# Frontend: Vercel (Next.js) | Backend: Railway (FastAPI + Persistent Volume)
# ==============================================================================

# Core Environment ("development" locally, "production" on Railway)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
# Railway injects PORT automatically; container binds 0.0.0.0:$PORT
HOST=0.0.0.0
PORT=8000
# Explicit CORS allowlist (JSON array or comma-separated origins; wildcards '*' are disallowed)
# In production on Railway, include your Vercel production URL (and preview URLs if used).
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Multi-Astronaut Persistence & Auth (MARSCOPE_SECRET_KEY is REQUIRED when ENVIRONMENT=production)
# On Railway with volume mounted at /data:
#   MARSCOPE_DATASETS_DIR=/data/datasets
#   DATABASE_URL=sqlite:////data/datasets/index/marscope_mission.sqlite
DATABASE_URL=
MARSCOPE_DATASETS_DIR=
MARSCOPE_SECRET_KEY=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
MARSCOPE_OPERATOR_TOKEN=
TRACKING_INGEST_TOKEN=

# Frontend Configuration (Vercel)
NEXT_PUBLIC_APP_NAME="MARSCOPE"
# Keep "/api" so Next.js/Vercel same-origin rewrites preserve HttpOnly/CSRF cookies
NEXT_PUBLIC_API_BASE_URL="/api"
# REQUIRED on Vercel: Railway backend HTTPS origin (no trailing slash)
# Example: BACKEND_INTERNAL_URL=https://marscope-backend-production.up.railway.app
BACKEND_INTERNAL_URL=

# Planetary Data & Geospatial Services (Public Open Access)
NEXT_PUBLIC_MARS_TREK_WMTS_BASE=https://trek.nasa.gov/tiles/Mars/EQ
NEXT_PUBLIC_MARS_MOLA_ELEVATION_BASE=https://trek.nasa.gov/tiles/Mars/EQ/mgs_mola_dem_128ppd

# Study Region Parameters: Gale Crater / Mount Sharp (Curiosity Boxwork Focus)
STUDY_AREA_NAME="Gale Crater - Mount Sharp Boxwork Exploration Zone"
STUDY_AREA_MIN_LAT=-5.5
STUDY_AREA_MAX_LAT=-4.3
STUDY_AREA_MIN_LON=137.2
STUDY_AREA_MAX_LON=138.0
DEFAULT_CRS="IAU2000:49900"
